{
	"name": "progresswatch",
	"version": "0.0.1",
	"description": "Report progress from any script, crawler, CI job or agent and watch it on your phone",
	"license": "MIT",
	"homepage": "https://progress.watch",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/progress-watch/progresswatch-cli.git"
	},
	"keywords": [
		"progress",
		"cli",
		"monitoring",
		"notifications"
	],
	"type": "module",
	"bin": {
		"progresswatch": "dist/cli.js"
	},
	"files": [
		"dist",
		"skills",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node build.mjs",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test \"test/**/*.test.mjs\"",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"qrcode-terminal": "^0.12.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/qrcode-terminal": "^0.12.2",
		"esbuild": "^0.28.1",
		"typescript": "^7.0.2"
	}
}
